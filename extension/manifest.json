{
  "manifest_version": 2,

  "name": "Market Analyzer",
  "version": "1.0",

  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "http://localhost:8000/*"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "browser_action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.ozon.ru/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}